<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>SillyClient</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.15.3</string>
	<key>CFBundleVersion</key>
	<string>54</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- 自定义 URL Scheme 支持 (用于自动化测试与外部唤醒) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.sillyclient.ios</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sillyclient</string>
			</array>
		</dict>
	</array>

	<!-- 开启 iOS 原生“文件”App 共享 (iTunes File Sharing & Open in Place) -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!-- 声明完整的原生文档与文件夹就地打开能力，确保侧载自签与系统“文件”选择器兼容 -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
				<string>public.directory</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Archive</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.zip-archive</string>
				<string>com.pkware.zip-archive</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Document</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
				<string>public.plain-text</string>
				<string>public.image</string>
				<string>public.data</string>
			</array>
		</dict>
	</array>

	<!-- 加密合规声明 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- 文件夹访问说明 -->
	<key>NSDocumentsFolderUsageDescription</key>
	<string>SillyClient 需要访问您的文稿与选定文件夹以安装、读取和备份本地酒馆实例。</string>

	<!-- 相册读写权限声明 (支持酒馆角色卡、封面图导入与备份图保存) -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>SillyClient 需要访问相册以选择实例封面图片及酒馆角色卡、背景资源。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>SillyClient 需要将图片或导出资源保存到您的相册。</string>

	<!-- 相机权限声明 (支持酒馆页面内上传拍照图片) -->
	<key>NSCameraUsageDescription</key>
	<string>SillyClient 需要使用相机以在酒馆页面内拍摄并上传图片。</string>

	<!-- 开启后台轻量静音音频保活，杜绝切后台被系统墓碑挂起 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- 本地酒馆 HTTP 访问权限 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- 本地局域网发现与访问权限声明 (支持局域网其他设备访问酒馆) -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>SillyClient 需要访问本地网络以允许本地酒馆服务运行及局域网设备协同访问。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
	</array>

	<!-- 麦克风访问权限声明 (支持酒馆语音输入与录音对讲功能) -->
	<key>NSMicrophoneUsageDescription</key>
	<string>SillyClient 需要使用麦克风以支持酒馆语音输入与录音对讲功能。</string>
</dict>
</plist>
